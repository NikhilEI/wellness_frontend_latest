NEXT_PUBLIC_API_BASE_URL=http://103.149.199.137:4010/api

# From https://www.google.com/recaptcha/admin — register 103-149-199-137.nip.io as the
# domain (it resolves to this server's IP and satisfies reCAPTCHA's domain requirement,
# since bare IP addresses aren't accepted). Site key is public, safe to commit here.
# IMPORTANT: reCAPTCHA checks the hostname the page was actually loaded from, so once
# this is set, the site must be visited as http://103-149-199-137.nip.io:3010/ — the
# bare-IP URL will fail the widget's domain check. Update backend/.env's CORS_ORIGIN to
# match (add http://103-149-199-137.nip.io:3010) when you switch over.
# Leave blank to skip rendering the captcha widget entirely — nothing breaks without it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
